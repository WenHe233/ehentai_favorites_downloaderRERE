FROM node:24.20.0-bookworm-slim AS node
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates git python3 python3-venv gcc-mingw-w64-x86-64 binutils-mingw-w64-x86-64 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=node /usr/local /usr/local
RUN python3 -m venv /opt/build && /opt/build/bin/pip install \
    uv==0.12.10 setuptools==80.9.0 wheel==0.45.1
ENV PATH=/opt/build/bin:/usr/local/bin:/usr/bin:/bin
WORKDIR /work
ENTRYPOINT ["python", "desktop/build.py"]
